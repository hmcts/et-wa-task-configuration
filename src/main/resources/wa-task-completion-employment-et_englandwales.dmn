      <input id="Input_support_admin_completion_ew" label="Admin Support Task No Longer Required">
        <inputExpression id="InputExpression_support_admin_completion_ew" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.supportTaskState!=null
and additionalData.Data.supportTaskState.adminTaskRequired!=null)
then additionalData.Data.supportTaskState.adminTaskRequired="No"
else false</text>
        </inputExpression>
      </input>
      <input id="Input_support_legalofficer_completion_ew" label="Legal Officer Support Task No Longer Required">
