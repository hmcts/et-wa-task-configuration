and additionalData.Data!=null
and additionalData.Data.supportTaskState!=null
and additionalData.Data.supportTaskState.judgeTaskRequired!=null)
then additionalData.Data.supportTaskState.judgeTaskRequired="No"
else false</text>
        </inputExpression>
      </input>
